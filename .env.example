# =============================================================================
# Contrat de variables d'environnement — COMMITÉ SANS VALEUR (D-12)
# Copier ce fichier et remplir les valeurs dans les fichiers locaux :
#   apps/web/.env.local   → NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY
#   apps/jobs/.env        → SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
# Ne JAMAIS commiter les fichiers .env ou .env.local avec des valeurs réelles.
# =============================================================================

# --- Côté WEB (apps/web/.env.local) ---
# URL du projet Supabase (publique, utilisée par le client anon côté navigateur/RSC)
NEXT_PUBLIC_SUPABASE_URL=
# Clé anonyme Supabase (publique, RLS protège les données)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Côté JOBS (apps/jobs/.env) ---
# URL du projet Supabase (identique à ci-dessus)
SUPABASE_URL=
# Clé service_role Supabase (SECRÈTE — bypass RLS — JAMAIS exposer côté web)
# Ne JAMAIS préfixer NEXT_PUBLIC_ sur cette variable
SUPABASE_SERVICE_ROLE_KEY=

# --- Data Sources (apps/jobs/.env) ---
# OANDA démo (api-fxpractice.oanda.com) — requis pour OHLCV forex/métaux/énergie
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=

# Binance — optionnel pour klines OHLCV (endpoint public mainnet non signé, sans clé)
# Requis uniquement si des opérations de compte sont nécessaires (hors Phase 2)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Finnhub free — requis pour news marché par catégorie (crypto/forex/general)
# Rate limit : 60 req/min. Sentiment et calendrier économique = premium-locked (non utilisé).
FINNHUB_API_KEY=

# Marketaux free — fallback news si Finnhub échoue ou rate-limité
MARKETAUX_API_KEY=

# FRED (Federal Reserve Economic Data) — requis pour séries macro (taux, CPI, DXY proxy, taux réels)
# Clé gratuite : https://fred.stlouisfed.org/docs/api/api_key.html
# Séries : DFF (Fed Funds), CPIAUCSL (CPI), DTWEXBGS (DXY proxy broad), DFII10 (taux réels 10 ans)
FRED_API_KEY=

# FairEconomy/ForexFactory calendrier économique — AUCUNE clé requise (flux JSON public)
# URL : https://nfs.faireconomy.media/ff_calendar_thisweek.json (cache recommandé 1×/jour max)
