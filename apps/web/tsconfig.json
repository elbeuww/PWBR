{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "dom",
      "dom.iterable",
      "ESNext"
    ],
    "jsx": "preserve",
    "incremental": true,
    "allowJs": true,
    "noEmit": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@app/core": [
        "../../packages/core/src/index.ts"
      ],
      "@app/core/*": [
        "../../packages/core/src/*"
      ],
      "@app/supabase": [
        "../../packages/supabase/src/index.ts"
      ],
      "@app/supabase/*": [
        "../../packages/supabase/src/*"
      ],
      "@app/data-sources": [
        "../../packages/data-sources/src/index.ts"
      ],
      "@app/data-sources/*": [
        "../../packages/data-sources/src/*"
      ]
    },
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
